# Application Configuration
APP_NAME=Kisan2Consumer
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kisan2consumer_db

# Security & JWT
JWT_SECRET_KEY=kisan2consumer_sih2026_super_secret_jwt_key_987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Verification & Email Tokens
EMAIL_TOKEN_EXPIRE_HOURS=24

# SMTP Email Configuration (Optional - falls back to dev in-memory/console logger)
SMTP_ENABLED=False
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=no-reply@kisan2consumer.in
SMTP_FROM_NAME="Kisan2Consumer Platform"

# Frontend Origin for CORS and links
FRONTEND_URL=http://127.0.0.1:5500
